<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for macOS TCC to prompt for/track microphone access under
       Hardened Runtime — without this, getUserMedia silently returns
       muted audio instead of prompting or throwing. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Electron/V8 need these under Hardened Runtime without notarization,
       otherwise the packaged app fails to start (JIT/executable memory). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
