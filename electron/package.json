{
  "name": "muse-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for MUSE: main process, preload bridge, system tray, global hotkeys, and window management.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron . --disable-gpu --disable-gpu-sandbox --no-sandbox",
    "dev": "npm run build && electron .",
    "lint": "tsc --noEmit",
    "package:mac": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@muse/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^32.2.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.msftmuse.muse",
    "productName": "MUSE",
    "electronVersion": "43.1.0",
    "electronDownload": {
      "isVerifyChecksum": false
    },
    "asar": true,
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MUSE uses your microphone for Press-to-Talk voice dictation."
      }
    }
  }
}
