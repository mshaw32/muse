# MUSE Environment Configuration
# Copy this to .env and fill in your values
# ⚠️ NEVER commit .env to Git!

# ============================================================================
# Copilot Studio Authentication (Phase 1)
# ============================================================================

# Copilot Studio API Endpoint
# For public cloud: https://copilot.microsoft.com/api
COPILOT_STUDIO_ENDPOINT=https://copilot.microsoft.com/api

# OAuth2 Client ID (from Azure AD app registration)
# Get from: Azure Portal → Azure Active Directory → App registrations → Your App → Application (client) ID
COPILOT_STUDIO_CLIENT_ID=

# OAuth2 Client Secret (from Azure AD app registration)
# Get from: Azure Portal → Azure Active Directory → App registrations → Your App → Certificates & secrets → Client secrets
# NOTE: Leave empty if using Managed Identity in Azure
COPILOT_STUDIO_CLIENT_SECRET=

# Azure AD Tenant ID (Directory ID)
# Get from: Azure Portal → Azure Active Directory → Overview → Directory (tenant) ID
COPILOT_STUDIO_TENANT_ID=

# ============================================================================
# Backend Configuration
# ============================================================================

# Express server port (default: 4000)
PORT=4000

# Environment (development, production)
NODE_ENV=development

# ============================================================================
# Voice Services (Phase 3 - optional for now)
# ============================================================================

# Azure Speech Services key and region
# Get from: Azure Portal → Speech resource → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ============================================================================
# Microsoft Graph (Phase 4 - optional for now)
# ============================================================================

# Microsoft Graph API endpoint (usually v1.0)
GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0

# ============================================================================
# Security & Deployment
# ============================================================================

# For Azure Container Apps (Managed Identity)
# These are set automatically when deployed to Azure
# MSI_ENDPOINT=http://169.254.169.254/metadata/identity/oauth2/token
# MSI_SECRET=<auto-set-by-azure>

# For production: use Azure Key Vault instead of .env
# Set this to enable Key Vault retrieval
AZURE_KEYVAULT_URL=
